{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits"
    ],
    "commitMessagePrefix": "#39: ",
    "platformAutomerge": true,
    "automergeType": "pr",
    "timezone": "Europe/Oslo",
    "schedule": [
        "before 6:00am on monday"
    ],
    "prHourlyLimit": 2,
    "prConcurrentLimit": 3,
    "gradle": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchManagers": ["gradle"],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "groupName": "Gradle minor and patch updates"
        },
        {
            "matchManagers": ["gradle"],
            "matchUpdateTypes": ["major"],
            "automerge": false,
            "groupName": "Gradle major updates",
            "labels": ["major-update", "dependencies"]
        },
        {
            "matchPackageNames": [
                "com.github.jactor-rises:jactor-shared"
            ],
            "enabled": false
        }
    ]
}
